# API key for the LLM endpoint used by src/sentiment_classifier.py.
# The key is read ONLY from this environment variable — the code has no
# hardcoded key and no default. Copy this file to .env (or export it) and
# fill in your key:
LLM_API_KEY=your-key-here

# Optional overrides (defaults are sensible for this project):
# LLM_BASE_URL=http://dobolyi.com:9000/v1
# LLM_MODEL=DeepSeek-V4-Flash-0731
